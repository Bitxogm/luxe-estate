# Mark lock files as generated/binary to hide them from diffs in GitHub/GitLab
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true

# Ensure LF for all text files (Cross-platform)
* text=auto eol=lf
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.css text
*.scss text
*.html text
